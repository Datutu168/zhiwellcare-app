# 智为康乐消费版后端环境变量（复制为 .env 填写；生产全部经环境注入，不入库）
#
# 写法约定：每条都注明「不配会怎样」，便于判断本地起服务时缺哪一项会有影响。
# 变量清单以 internal/config/config.go 为准；新增变量请同步更新本文件与 DEPLOYMENT.md。
APP_ADDR=:8080
# 不配会怎样：监听 :8080。

# PostgreSQL 连接串（生产必填）
# 不配会怎样：回退内存存储（演示模式）—— 接口都能跑通，但重启即丢数据，启动日志打 WARN。
# 启动日志会打印实际连到的主机与库名（不含口令），主机不是本机时额外打 WARN ——
# 这样「APP_DB_URL 被误清空、godotenv 又从 .env 回填正式库」这类事故能一眼发现。
APP_DB_URL=postgres://zhiwellcare:CHANGE_ME@127.0.0.1:5432/zhiwellcare?sslmode=disable

# JWT 访问令牌签名密钥（生产必须注入长随机串：openssl rand -hex 32）
# 不配会怎样：使用内置开发密钥（仅联调可接受；生产等于任何人可伪造登录态）。
APP_JWT_SECRET=change-me-to-a-long-random-secret

# 访问令牌有效期（分钟，默认 120）
# 不配会怎样：120 分钟。刷新令牌有效期固定 30 天（代码常量，无对应变量）。
APP_ACCESS_TTL_MINUTES=120

# 跨端 CORS 允许来源（网页/Tauri/Capacitor 列表）
# 不配会怎样：用内置开发默认值（localhost 各端口 + tauri/capacitor scheme）；生产必须显式配正式域名。
APP_CORS_ORIGINS=http://localhost:1420,http://localhost:4173,http://tauri.localhost,capacitor://localhost,https://game.zhiwellcare.com

# 日志：结构化 JSON（生产建议 true）、请求日志开关、Gin Debug（生产 false）
# 不配会怎样：LogJSON=true、LogRequests=true、Debug=false。
APP_LOG_JSON=true
APP_LOG_REQUESTS=true
APP_DEBUG=false

# 启动时把已注册的该手机号用户提升为管理员（RBAC 引导；可留空）
# 不配会怎样：不做任何引导（角色请用 /admin/roles 与 /admin/users/:id/roles 维护）。
APP_ADMIN_BOOTSTRAP_PHONE=

# 微信开放平台小程序/公众号登录
# 不配会怎样：微信登录走本地 Mock（同一 code 幂等返回同一账号，仅联调可用）。
APP_WECHAT_APPID=
APP_WECHAT_SECRET=

# =====================================================================
# Redis（权限集合缓存、设备映射/白名单读缓存、访问令牌吊销名单、分布式限流计数）
# 不配 或 连不上：自动回退进程内实现 —— 单实例部署功能与行为完全一致；
# 多实例部署必须接 Redis，否则限流额度、登出吊销、设备与权限缓存都不跨实例共享。
# =====================================================================
# APP_REDIS_URL=redis://127.0.0.1:6379/0
APP_REDIS_URL=

# 设备映射 / 白名单 / 用户权限集合的读缓存 TTL（秒，默认 300）
# 不配会怎样：5 分钟。写路径（增删白名单/映射、分配用户角色、改角色权限）会主动失效缓存，
#             所以运营改动与权限调整都立即生效，不必等 TTL 到期。
APP_DEVICE_CACHE_TTL_SECONDS=300

# =====================================================================
# 对象存储（S3 兼容：MinIO / 阿里云 OSS / 腾讯云 COS / AWS S3）
# 存放：Web 包 web/、游戏资源 games/、固件 firmware/、训练采样 samples/
# 四项（ENDPOINT/ACCESS_KEY/SECRET_KEY/BUCKET）任一为空即视为未配置 → 回退本地磁盘模式。
# 桶不存在时后端会自动创建（MakeBucket），无需手工建桶。
# =====================================================================
# APP_S3_ENDPOINT=minio.example.com:9000
APP_S3_ENDPOINT=
# 不配会怎样：整组 S3 配置视为未启用，回退本地磁盘（APP_S3_LOCAL_DIR）。
APP_S3_REGION=us-east-1
# 不配会怎样：us-east-1（部分自建 MinIO 需要显式指定）。
APP_S3_ACCESS_KEY=
APP_S3_SECRET_KEY=
# 不配会怎样：同上，任一为空即回退本地磁盘。
# APP_S3_BUCKET=zhiwellcare
APP_S3_BUCKET=
# 不配会怎样：同上，任一为空即回退本地磁盘。
# 对象存储是否走 HTTPS（内网 MinIO 常见为 false）
# 不配会怎样：true。
APP_S3_USE_SSL=true

# 未配置 S3 时的本地磁盘根目录：预签名地址会指向本服务的签名端点
# PUT/GET /api/v1/files/{key}?op=&exp=&sig=（HMAC-SHA256）
# 不配会怎样：storage/objects（相对进程工作目录；容器内对应 /app/storage 卷）。
APP_S3_LOCAL_DIR=storage/objects

# 预签名上传/下载地址有效期（秒，默认 900）
# 不配会怎样：15 分钟。值越小越安全，但客户端大文件上传/下载要留足时间。
APP_UPLOAD_URL_TTL_SECONDS=900

# 本地对象存储预签名密钥
# 不配会怎样：复用 APP_JWT_SECRET（少一个必填项；生产建议独立配置，便于单独轮换）。
APP_UPLOAD_SIGN_SECRET=

# =====================================================================
# 对外地址与 CDN（静态资源下发地址的来源）
# =====================================================================
# 本服务对外基础地址：本地对象存储模式下据此拼预签名直传/下载地址
# 不配会怎样：该模式下无法生成直传地址（启动时打印提示），只能服务端中转上传；
#             S3 模式下不影响（预签名地址由对象存储自身域名生成）。
APP_PUBLIC_BASE_URL=http://127.0.0.1:8080

# 静态资源（Web 包/游戏资源/固件/采样文件）CDN 前缀
# 配置后：/app/web-bundle、/device/:modelId/firmware 与目录回填的 resourceUrl 优先下发 CDN 地址
# 不配会怎样：自动回退对象存储「预签名地址」（带有效期；本地磁盘模式即本服务签名 URL）。
# 注意：CDN 前缀需与实际对象键对齐，例如资源键 games/{gameId}/{version}/{filename}。
APP_CDN_BASE=

# 当前 Web 资源版本号（构建/发布脚本用；可留空）
# 不配会怎样：留空。GET /api/v1/app/web-bundle 以「资产库中该 platform 最新 published 资产」的
#             version 为准，当前后端代码并不读取本变量。
APP_WEB_BUNDLE_VERSION=
