{
  "name": "zhiwellcare-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "智为康乐 ZhiWellCare 消费级智能训练 APP —— 多端统一 Web 架构（手机/平板/Windows/网页一套代码）",
  "scripts": {
    "dev": "vite",
    "version:sync": "node scripts/sync-version.mjs --write",
    "version:check": "node scripts/sync-version.mjs --check",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:macos": "tauri build --bundles app,dmg",
    "tauri:build:macos:universal": "tauri build --bundles app,dmg --target universal-apple-darwin",
    "cap": "cap",
    "android:sync": "npm run build && cap sync android",
    "android:build:debug": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "android:build:release": "npm run android:sync && cd android && gradlew.bat assembleRelease",
    "android:bundle": "npm run android:sync && cd android && gradlew.bat bundleRelease"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^8.3.0",
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/screen-orientation": "^8.0.1",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-updater": "2.11.0",
    "pinia": "^3.0.0",
    "pixi.js": "^8.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "fake-indexeddb": "^6.2.5",
    "typescript": "~5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0",
    "vue-tsc": "^2.2.0"
  }
}
