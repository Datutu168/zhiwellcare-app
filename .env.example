# ============================================================
# 智为康乐 zhiwellcare-app 环境变量参考（仅变量名，勿提交真实值）
# ============================================================

# 平台能力来源：mock | http（默认 mock：设备/游戏目录走本地配置源）
VITE_CATALOG_MODE=mock

# 后端目录接口基础地址（VITE_CATALOG_MODE=http 时生效；注册/登录也复用该地址）
# GET  {base}/api/v1/device/{model}/games   → 设备可用游戏（含 CDN 资源地址/灰度）
# GET  {base}/api/v1/catalog/devices        → 设备型号目录
# POST {base}/api/v1/training/records       → 训练记录上报
# POST {base}/api/v1/auth/register|login    → 注册/登录（本地开发默认 http://127.0.0.1:8080）
VITE_API_BASE=http://127.0.0.1:8080

# 上报模式：local（默认，落 localStorage 待发队列）| http（直传后端）
VITE_REPORT_MODE=local

# 训练高频采样文件上传：off（默认，不发任何请求）| http（经后端预签名地址直传对象存储/S3）
VITE_SAMPLES_MODE=off

# 游戏资源 CDN 前缀（可留空）；条目自带的 resourceUrl 优先，本项作为全局兜底前缀。
# 注意：后端对象键形如 games/{gameId}/{version}/{filename}，因此本前缀需包含 games 这一段，
#       例如 https://cdn.example.com/games （解析器会再拼 /{gameId}/{resourceVersion}/）。
# 约定：游戏资源发布时把 manifest.json 作为该版本的资产登记，resourceUrl 即为该清单地址，
#       清单同目录下的资源文件按相对路径解析；清单缺失/不可用时前端静默回退内置资源。
VITE_GAME_RESOURCE_CDN=

# 仅列出变量名，真实路径和密码请在构建终端中设置。
REHAB_ANDROID_KEYSTORE_PATH=
REHAB_ANDROID_STORE_PASSWORD=
REHAB_ANDROID_KEY_PASSWORD=
REHAB_ANDROID_KEY_ALIAS=zhiwellcare
TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
